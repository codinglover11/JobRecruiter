# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=job_scraper
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Apify
APIFY_TOKEN=your_apify_api_token
APIFY_NAUKRI_ACTOR_ID=muhammetakkurtt~naukri-job-scraper
APIFY_LINKEDIN_ACTOR_ID=curious_coder~linkedin-jobs-scraper

# Seed users (used only by `npm run seed`, remove after seeding if you like)
SEED_USER_1_EMAIL=user1@example.com
SEED_USER_1_PASSWORD=change_me
SEED_USER_2_EMAIL=user2@example.com
SEED_USER_2_PASSWORD=change_me
